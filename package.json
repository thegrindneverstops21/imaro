{
  "name": "imaro-hotel-api",
  "version": "1.0.0",
  "private": true,
  "description": "Imaro hotel booking API and React frontend",
  "dependencies": {
    "@heroui/react": "^2.8.10",
    "@heroui/theme": "^2.4.26",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@reduxjs/toolkit": "^2.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "framer-motion": "^12.43.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "sharp": "^0.34.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "dev": "tsx watch backend/src/server.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.build.json",
    "build:client": "tsc -p tsconfig.client.json && vite build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:setup": "tsx backend/src/db/migrate.ts",
    "db:migrate": "tsx backend/src/db/migrate.ts migrate",
    "db:seed": "tsx backend/src/db/migrate.ts seed",
    "payfast:check": "node scripts/check-payfast.mjs",
    "design:build": "node scripts/build-refinements.cjs"
  }
}
