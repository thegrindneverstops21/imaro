NODE_ENV=development
PORT=4000
# Replace YOUR_PASSWORD with your URL-encoded PostgreSQL password (no surrounding spaces).
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/imaro
TEST_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/imaro_test
# Local development origins; deployed frontend: https://imaro.vercel.app
# On the hosted API, set CLIENT_URL=https://imaro.vercel.app.
CLIENT_URL=http://localhost:5173
# On Vercel, set VITE_API_URL=https://imaro.onrender.com/api/v1.
VITE_API_URL=http://localhost:4000/api/v1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# On Render, use https://imaro.onrender.com/api/v1/auth/google/callback.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAILS=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# On Render, use https://imaro.onrender.com/api/v1/payments/payfast/notify.
PAYFAST_NOTIFY_URL=http://localhost:4000/api/v1/payments/payfast/notify
PAYFAST_RETURN_URL=http://localhost:5173/payment/return
PAYFAST_CANCEL_URL=http://localhost:5173/payment/cancelled
# Device photo uploads: use a persistent volume in production.
UPLOAD_DIR=uploads
